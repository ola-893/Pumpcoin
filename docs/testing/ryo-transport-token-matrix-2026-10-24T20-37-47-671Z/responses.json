      "rateHeaders": {},
      "contentType": "application/json",
      "body": "{\"jsonrpc\": \"2.0\", \"id\": 2, \"result\": {\"tools\": [{\"name\": \"market_overview\", \"description\": \"Delivery: a compact market-regime evidence pack with sentiment, market totals, dominance, movers, and explicit data gaps. Use when: an agent needs a broad market briefing before token research. Core inputs: none. Limits: research context only; incomplete lanes are marked partial or unavailable.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {}, \"additionalProperties\": false}}, {\"name\": \"scan_market\", \"description\": \"Delivery: a ranked candidate set with price, momentum, market-activity evidence, filters, and reasons where available. Use when: an agent needs a shortlist before deeper token analysis. Core inputs: optional chain, theme, and top_n. Limits: theme is contextual rather than a strict filter; a scan is not a trade instruction.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"chain\": {\"type\": \"string\", \"description\": \"Chain slug e.g. eth/bsc (optional).\"}, \"theme\": {\"type\": \"string\", \"description\": \"Narrative/theme filter (optional).\"}, \"top_n\": {\"type\": \"number\", \"description\": \"How many candidates to return.\"}, \"filter_direction\": {\"type\": \"string\", \"description\": \"Direction filter: 'positive' (gainers only), 'negative' (losers only), or 'all' (default).\"}}, \"additionalProperties\": false}}, {\"name\": \"analyze_token\", \"description\": \"Delivery: a single-token research pack with USD market data, multi-window performance, calculated RSI and ATR, intelligence, summary, and warnings. Use when: an agent needs a quick structured token read. Core input: symbol. Limits: missing measurements are reported as unavailable and the result is not execution advice.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"symbol\": {\"type\": \"string\", \"description\": \"Token symbol, e.g. INJ.\"}, \"chain\": {\"type\": \"string\", \"description\": \"Chain slug for contract-specific safety, e.g. eth/bsc (optional).\"}}, \"required\": [\"symbol\"], \"additionalProperties\": false}}, {\"name\": \"deep_analysis\", \"description\": \"Delivery: a deeper token evidence pack combining market context, confluence, technicals, an optional Skill Hub token profile, derivatives, catalysts, risks, and a measured-ATR preview plan. Use when: an agent needs one comprehensive token read. Core input: token symbol; optional include_perp. Limits: token analysis only, not wallet analysis; unavailable lanes remain explicit and no trade is placed.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"symbol\": {\"type\": \"string\", \"description\": \"Token symbol, e.g. SOL.\"}, \"chain\": {\"type\": \"string\", \"description\": \"Chain slug for contract-specific safety (optional).\"}, \"include_perp\": {\"type\": \"boolean\", \"description\": \"Include derivatives/perp posture (default true).\"}}, \"required\": [\"symbol\"], \"additionalProperties\": false}}, {\"name\": \"compare_tokens\", \"description\": \"Delivery: a side-by-side comparison of two to four tokens with factor winners, coverage by token, an overall pick, rationale, confidence, and conclusion method. Use when: an agent must compare relative momentum, market activity, and volatility using common data. Core inputs: symbols; optional intent. Limits: missing factors are disclosed and deterministic conclusions are labelled.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"symbols\": {\"type\": \"string\", \"description\": \"2-4 token symbols to compare, comma- or space-separated, e.g. 'SOL, AVAX'.\"}, \"intent\": {\"type\": \"string\", \"description\": \"Trade horizon the pick is for: swing | hold | spot (optional).\", \"enum\": [\"swing\", \"hold\", \"spot\"]}}, \"required\": [\"symbols\"], \"additionalProperties\": false}}, {\"name\": \"monitor_market_sentiment_shift\", \"description\": \"Delivery: a seven-day market sentiment evidence pack containing Fear & Greed level and change, BTC perpetual funding crowding, BTC liquidation pressure and side, altseason phase, the combined regime, observation dates, coverage scope, and full measurements. Use when: an agent needs to check whether market sentiment materially shifted. Core inputs: optional time_window fixed to 7d. Limits: market-wide context except for BTC-referenced derivatives; no causality claim or advice.\", \"inputSchema\": {\"type\": \"object\", \"properties\": {\"time_window\": {\"type\": \"string\", \"enum\": [\"7d\"], \"default\": \"7d\", \"description\": \"Sentiment comparison window; currently fixed to seven days.\"}}, \"additionalProperties\": false}}]}}"
    },
