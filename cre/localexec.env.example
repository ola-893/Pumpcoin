# CRE local-execution secrets. Copy to ignored cre/localexec.env and fill the value
# from the verifier operator. The token must equal the verifier's VERIFIER_API_TOKEN.
# Never commit the filled file. The committed fixture token is public test data only.
VERIFIER_API_TOKEN=REPLACE_WITH_VERIFIER_TOKEN_AT_LEAST_32_CHARACTERS
# Only the authenticated CRE CLI broadcast path uses these values.
MONAD_TESTNET_RPC_URL=REPLACE_WITH_MONAD_TESTNET_HTTPS_RPC
CRE_ETH_PRIVATE_KEY=REPLACE_WITH_FUNDED_TESTNET_SIMULATION_SIGNER
# Standalone tools use the receiver's separately pinned operator/forwarder keys.
CRE_OPERATOR_PRIVATE_KEY=REPLACE_WITH_RECEIVER_OPERATOR_KEY
CRE_FORWARDER_PRIVATE_KEY=REPLACE_WITH_RECEIVER_FORWARDER_KEY
