{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": [
    "tests/**/*.ts",
    "vault/**/*.ts",
    "local-inference/**/*.ts",
    "agent-registration/**/*.ts",
    "market-data/**/*.ts",
    "research/**/*.ts",
    "practice/**/*.ts",
    "hosting/**/*.ts",
    "api/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "contracts",
    "archive"
  ]
}
