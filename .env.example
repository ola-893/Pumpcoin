# Private server configuration. Copy to the root .env; never commit filled values.
# Network addresses and runtime pins live in deployments/pumpcoin-*-network.json.

# Pyth USDC data access; read only by the server, never a VITE_ browser variable.
PUMPCOIN_PYTH_API_KEY=

# Encrypted execution signer: paths only, never a raw private key.
PUMPCOIN_SIGNER_PASSWORD_FILE=
PUMPCOIN_SIGNER_DIRECTORY=

# Optional operator-reviewed autonomous worker configuration.
# Configure the worker and fund its execution wallet before starting it in the UI.
PUMPCOIN_AUTONOMY_CONFIG=

# Lending, CRE and oracle-identity examples are in archive/credit/.env.example.
