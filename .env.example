# Private server configuration. Copy to the root .env; never commit filled values.
# Network addresses and runtime pins live in deployments/pumpcoin-*-network.json.

# Local operator deployment only. Never use a VITE_ prefix or send this value to the browser.
PRIVATE_KEY=

# New registrations default to Ethereum Sepolia. Reviewed profiles:
# deployments/pumpcoin-sepolia-vault-network.json and pumpcoin-sepolia-trading-network.json.
# Optional override for explicitly reviewed historical/local setups:
# PUMPCOIN_VAULT_NETWORK_CONFIG=/absolute/path/to/reviewed-network.json

# Historical Monad Pyth USDC data access; read only by the server, never a VITE_ browser variable.
PUMPCOIN_PYTH_API_KEY=

# Encrypted execution signer: paths only, never a raw private key.
PUMPCOIN_SIGNER_PASSWORD_FILE=
PUMPCOIN_SIGNER_DIRECTORY=

# Optional operator-reviewed autonomous worker configuration.
# Configure the worker and fund its execution wallet before starting it in the UI.
PUMPCOIN_AUTONOMY_CONFIG=

# Lending, CRE and oracle-identity examples are in archive/credit/.env.example.

# Hosted API: generate a separate random 32-byte secret.
# Keep both settings server-only. The Blob token is provisioned by Vercel storage.
PUMPCOIN_HOSTED_SESSION_SECRET=
# Netlify's public evidence-reader deployment disables transaction reviews.
PUMPCOIN_HOSTED_READ_ONLY=true
BLOB_READ_WRITE_TOKEN=

# RYO practice research: operator server only. Obtain official builder access first.
# URL and auth header must come from RYO's builder documentation, not a guessed endpoint.
PUMPCOIN_RYO_MCP_URL=
PUMPCOIN_RYO_API_KEY=
# Optional lower request ceiling; never exceeds the adapter's 30/minute cap.
PUMPCOIN_RYO_RATE_PER_MINUTE=6
PUMPCOIN_RYO_AUTH_HEADER=Authorization
PUMPCOIN_RYO_AUTH_PREFIX="Bearer "
# Absolute path to a reviewed tool-arguments / response-field mapping JSON file.
# Optional for RYO-only pricing. New signed policies can select free public Coinbase
# USD spot books instead; no Coinbase credential is needed.
PUMPCOIN_RYO_PROFILE=
# Comma-separated, operator-allowlisted HTTPS RSS/Atom/JSON feed URLs.
PUMPCOIN_NEWS_FEEDS=
# X collection is removed. No X credential or API purchase is required.
