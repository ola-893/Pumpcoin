# Verifier local-execution environment for authentic Stripe TEST-MODE proofs.
# Copy to an ignored file (e.g. .env.eligibility) and fill every REPLACE value.
# Do NOT use this file for the public fixture server (eligibility:fixtures).
#
# Test mode is allowed here AND in cre/eligibility/config.localexec.*.json.
# Fixtures stay disabled: the server hardcodes allowFixtures=false and only
# serves Reclaim-verified receipts. Proof validation (provider hashes, TEE
# attestation, wallet/session binding) is unchanged by test mode.
RECLAIM_APP_ID=REPLACE_WITH_APP_ID
RECLAIM_APP_SECRET=REPLACE_WITH_APP_SECRET
# Reviewed Stripe test-mode provider (pinned ID/version, NOT a fixture name).
RECLAIM_PROVIDER_ID=REPLACE_WITH_REVIEWED_STRIPE_TEST_PROVIDER_ID
RECLAIM_PROVIDER_VERSION=REPLACE_WITH_PINNED_VERSION
# Exact reviewed provider content hashes; the verifier fails closed without them.
RECLAIM_PROVIDER_HASHES=["REPLACE_WITH_REVIEWED_CONTENT_HASH"]
SOURCE_ID_KEY=REPLACE_WITH_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
VERIFIER_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
ELIGIBILITY_CHAIN_ID=10143
ELIGIBILITY_REGISTRY=REPLACE_WITH_NEW_REGISTRY_ADDRESS
ALLOW_RECLAIM_TEST_MODE=true
